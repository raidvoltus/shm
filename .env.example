# Copy to .env for local development. Never commit .env.
# All secrets must come from environment / GitHub Secrets.

# Trading mode (LIVE_TRADING must stay false)
PAPER_TRADING=true
PAPER_TRADING_ONLY=true
LIVE_TRADING=false
INITIAL_BALANCE=10000000
INITIAL_CAPITAL_IDR=10000000

# Transaction cost in basis points (configurable; not hard-coded market fact)
TRANSACTION_COST_BPS=15

# Feature flags
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ML / Governor
MAX_TRAINING_MINUTES=19
MAX_MODELS=7
MIN_MODELS=1
ENABLE_COLAB=false
ENABLE_LOCAL_TRAINING=true
# COLAB_JOB_ENDPOINT=

# Runtime
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta
RANDOM_SEED=42
IDXBOT_USE_FIXTURE=true

# Durable production state (required in CI/production; local may use STATE_BACKEND=local)
# IDXBOT_STATE_BACKEND=s3
# IDXBOT_S3_ENDPOINT=https://<s3-compatible-endpoint>
# IDXBOT_S3_BUCKET=<bucket>
# IDXBOT_S3_ACCESS_KEY=<access-key>
# IDXBOT_S3_SECRET_KEY=<secret-key>
# IDXBOT_S3_REGION=us-east-1
# IDXBOT_S3_PREFIX=idxbot/state/
